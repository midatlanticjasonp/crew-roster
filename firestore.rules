rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only your own Google account can read or write the roster.
    // Replace the ID below with your user ID (README step 4 shows where to find it).
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == "PASTE-YOUR-USER-ID-HERE";
    }
  }
}
